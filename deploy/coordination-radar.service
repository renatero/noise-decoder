[Unit]
Description=Coordination Radar demo
After=network.target

[Service]
Type=simple
User=joepeach
Group=joepeach
WorkingDirectory=/home/joepeach/noise-decoder
Environment=PYTHONUNBUFFERED=1
# Nginx exposes the dashboard while the existing Noise Decoder API stays on port 8000.
ExecStart=/home/joepeach/noise-decoder/.venv/bin/uvicorn src.api.main:app --host 127.0.0.1 --port 8001 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
