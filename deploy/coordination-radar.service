[Unit]
Description=Coordination Radar demo
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/projects/noise-decoder
EnvironmentFile=-/etc/noise-decoder/context.env
EnvironmentFile=-/etc/noise-decoder/reddit.env
Environment=CONTEXT_STATE_PATH=/var/lib/noise-decoder/context.sqlite3
Environment=NOISE_STATE_DIR=/var/lib/noise-decoder/settings
StateDirectory=noise-decoder
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Nginx terminates public HTTPS and proxies to this local-only application.
ExecStart=/opt/projects/noise-decoder/.venv/bin/python -m uvicorn src.api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
